{
  "name": "@sendsafely/mcp-tools-core",
  "version": "1.0.5",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "stdioPrune": [
    "dist/http",
    "dist/tools/http"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/finish-tools-core-build.mjs",
    "build:publish": "tsc -p tsconfig.publish.json && node ../../scripts/finish-tools-core-build.mjs --strip-comments",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint --config ../../eslint.config.mjs src tests"
  },
  "devDependencies": {
    "@types/mime-types": "3.0.1",
    "@types/node": "24.12.2"
  }
}
