{
  "name": "@sendsafely/mcp-server-local",
  "version": "1.0.6",
  "license": "Apache-2.0",
  "description": "SendSafely MCP server (stdio transport) for Claude Desktop, Claude Code, Cursor and other MCP clients: send, receive, download and decrypt files on the SendSafely secure file transfer platform.",
  "keywords": [
    "sendsafely",
    "mcp",
    "model context protocol",
    "secure file transfer",
    "end to end encryption"
  ],
  "author": "SendSafely",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SendSafely/SendSafelyMCP.git"
  },
  "homepage": "https://github.com/SendSafely/SendSafelyMCP#readme",
  "bugs": {
    "url": "https://github.com/SendSafely/SendSafelyMCP/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24.16.0",
    "npm": ">=11.11.0"
  },
  "bin": {
    "sendsafely-mcp-server": "./dist/server.js",
    "sendsafely-setup-credentials": "./dist/setupCredentials.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "NOTICE",
    "npm-shrinkwrap.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:publish": "tsc -p tsconfig.publish.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint --config ../../eslint.config.mjs src tests"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@napi-rs/keyring": "1.2.0",
    "@sendsafely/mcp-tools-core": "*",
    "@sendsafely/sendsafely": "4.0.1",
    "mime-types": "3.0.2",
    "pdf-to-png-converter": "4.2.1",
    "zod": "4.6.7"
  },
  "bundleDependencies": [
    "@sendsafely/mcp-tools-core"
  ],
  "devDependencies": {
    "@types/node": "24.12.2"
  }
}
